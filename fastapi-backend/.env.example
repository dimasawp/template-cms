# ─── Application ────────────────────────────────────────────────────
APP_NAME=CMS Template API
APP_VERSION=1.0.0
ENV=development
DEBUG=True

# ─── Database ───────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=db_cms_template

# ─── JWT ────────────────────────────────────────────────────────────
SECRET_KEY=CHANGE_ME_TO_RANDOM_SECRET
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── File Upload ────────────────────────────────────────────────────
MAX_FILE_SIZE=10485760
ALLOWED_EXTENSIONS=jpg,jpeg,png,gif,webp,pdf,xlsx,docx,csv
UPLOAD_DIR=storage/uploads

# ─── Email (SMTP) ──────────────────────────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@example.com
SMTP_FROM_NAME=CMS Template
SMTP_USE_TLS=False

# ─── Logging ────────────────────────────────────────────────────────
LOG_DIR=logs
LOG_MAX_BYTES=104857600
LOG_BACKUP_COUNT=5

# ─── CORS ───────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

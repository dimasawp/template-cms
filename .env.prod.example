# ─────────────────────────────────────────────────────────────
# .env.prod.example — Production Configuration
#
# Copy ke .env.prod lalu sesuaikan. Gunakan dengan:
#   docker compose --env-file .env.prod -f docker-compose.prod.yml --profile local-db up -d --build
#
# Pilih skenario (lihat docs/plans/dev-production-nginx.md):
#   Domain:   A (subdomain) | B (satu domain + path) | C (staging via port)
#   HTTPS:    H1 (HTTP) | H2 (self-signed) | H3 (Let's Encrypt)
#   Database: D1 (container) | D2 (eksternal)
# ─────────────────────────────────────────────────────────────

# ─── Nginx — pilih skenario domain & HTTPS ───────────────────
SITE_MODE=single                      # subdomain (A) | single (B)
NGINX_HTTPS=false                     # true (H2/H3) | false (H1)
DOMAIN=example.com                    # domain utama
NGINX_HTTP_PORT=80                    # skenario C: ganti 8080
NGINX_HTTPS_PORT=443                  # skenario C: ganti 8443
# CERT_FILE=/etc/letsencrypt/live/example.com/fullchain.pem   # default sudah ke sini
# CERT_KEY=/etc/letsencrypt/live/example.com/privkey.pem

# ─── Database ────────────────────────────────────────────────
# D1 (MySQL container): DB_HOST=db
# D2 (DB eksternal):    DB_HOST=<host-managed-db>, DB_PORT=<port>
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD
DB_HOST=db
DB_PORT=3306
DB_USER=cms_user
DB_PASSWORD=CHANGE_ME_DB_PASSWORD
DB_NAME=db_cms_template

# ─── Backend ─────────────────────────────────────────────────
SECRET_KEY=GENERATE_LONG_RANDOM_STRING_64_CHARS
CORS_ORIGINS=https://admin.example.com,https://public.example.com
STORAGE_MODE=local_project

# ─── Frontend build args ─────────────────────────────────────
# Skenario A (subdomain):
#   VITE_API_BASE_URL=https://api.example.com/api/v1
#   ADMIN_VITE_BASE_PATH=/
#   PUBLIC_VITE_BASE_PATH=/
# Skenario B (satu domain + path):
#   VITE_API_BASE_URL=https://example.com/api/v1
#   ADMIN_VITE_BASE_PATH=/admin/
#   PUBLIC_VITE_BASE_PATH=/public/
VITE_API_BASE_URL=https://example.com/api/v1
ADMIN_VITE_BASE_PATH=/admin/
PUBLIC_VITE_BASE_PATH=/public/
